# ============================================================
#  Atlassian Automation — Environment Variables
#  Copy file ini menjadi .env dan isi dengan nilai asli
# ============================================================

# --- Atlassian Credentials ---
ATLASSIAN_EMAIL=youremal@company.com
ATLASSIAN_PASSWORD=password

# --- MFA / TOTP (jika menggunakan Authenticator App) ---
# Isi dengan secret key dari Authenticator App kamu
# Cara dapat: saat setup MFA, pilih "Can't scan QR code?" → copy secret key
ATLASSIAN_TOTP_SECRET=YOUR_TOTP_SECRET_HERE

# --- Target URL ---
ATLASSIAN_ADMIN_URL=https://admin.atlassian.com
ATLASSIAN_TOKEN_URL=https://id.atlassian.com/manage-profile/security/api-tokens

# --- Browser Settings ---
# true = background (tidak muncul window), false = muncul window browser
HEADLESS=true

# --- Page Settings ---
# true = gunakan page dengan session login yang sudah ada (jika ada), false = selalu buat page baru tanpa session
PAGE_WITH_SESSION=true

# --- Scheduler Settings ---
# Interval renewal token dalam hari (Atlassian max 365 hari)
TOKEN_RENEWAL_INTERVAL_DAYS=30

TOKEN_RENEWAL_THRESHOLD_DAYS=7

BASE_TOKEN_NAME=API_TOKEN_

# --- Logging ---
LOG_LEVEL=DEBUG

# --- Database Connection ---
DB_HOST=192.168.0.110
DB_PORT=5432
DB_NAME=atlassian_automation
DB_USER=postgres
DB_PASSWORD=rServerpss
